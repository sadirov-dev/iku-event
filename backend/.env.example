NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iku_events

# Generate with: bun -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Campus timezone — used for "today", "this week" etc.
APP_TIMEZONE=Asia/Bishkek

UPLOAD_DIR=uploads

# System accounts — created on every start if missing; their passwords are kept equal to these values.
# The main admin can never be blocked or demoted. In production the passwords are required
# (no defaults); locally they fall back to Admin123! / Organizer123! / Student123!.
ADMIN_EMAIL=admin@iku.kg
ADMIN_PASSWORD=
ORGANIZER_EMAIL=organizer@iku.kg
ORGANIZER_PASSWORD=
STUDENT_EMAIL=student@iku.kg
STUDENT_PASSWORD=

# Production demo deploy: load demo events/announcements on first start
# SEED_DEMO_DATA=true
