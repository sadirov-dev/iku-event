NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iku_events

# Generate with: bun -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Campus timezone — used for "today", "this week" etc.
APP_TIMEZONE=Asia/Bishkek

UPLOAD_DIR=uploads
